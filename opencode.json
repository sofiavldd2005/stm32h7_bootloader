{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "*": "allow",
      "*.env*": "deny",
      "**/.ssh/*": "deny",
      "**/id_rsa*": "deny"
    },
    "edit": "ask",
    "webfetch": "allow",
    "websearch": "allow",
    "question": "allow",
    "lsp": "allow",
    "external_directory": "ask",
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "touch *": "ask",
      "mv *": "ask",
      "git commit *": "ask",
      "git pull *": "ask",
      "git push *": "ask",
      "git reset *": "ask",
      "git clean *": "ask",
      "sudo *": "deny",
      "npm install -g *": "ask",
      "brew *": "ask",
      "apt *": "ask"
    }
  }
}
